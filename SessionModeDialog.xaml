<Window x:Class="pokersoc_connect.SessionModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Session Type"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="400">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="What type of session are you creating?"
               FontSize="16"
               FontWeight="Bold"
               Margin="0,0,0,16"/>

    <StackPanel Grid.Row="1" Margin="0,0,0,20">
      <RadioButton x:Name="CashGameRadio"
                   Content="Cash Game"
                   IsChecked="True"
                   FontSize="14"
                   Margin="0,0,0,8"/>
      <TextBlock Text="Standard buy-ins with flexible amounts and cash-outs."
                 Margin="24,0,0,12"
                 Foreground="Gray"
                 TextWrapping="Wrap"/>
      <RadioButton x:Name="TournamentRadio"
                   Content="Tournament"
                   FontSize="14"
                   Margin="0,0,0,8"/>
      <TextBlock Text="Fixed buy-in amounts, tournament settings, and blind structure."
                 Margin="24,0,0,0"
                 Foreground="Gray"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
