<UserControl x:Class="pokersoc_connect.Views.TournamentPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Pricing Structure" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
              Width="30" Height="30" Click="Close_Click" FontSize="16"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Type of Pricing Structure" Margin="0,0,0,16">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ArcStructureButton"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16,20"
                    Click="ArcStructure_Click"
                    BorderThickness="3"
                    BorderBrush="#2E6DA4"
                    Background="#E8F4FD">
              <StackPanel>
                <TextBlock Text="ARC vs Non-ARC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Two prices: ARC member and non-ARC member"
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="MembershipStructureButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,20"
                    Click="MembershipStructure_Click"
                    BorderThickness="3"
                    BorderBrush="Gray"
                    Background="#F5F5F5">
              <StackPanel>
                <TextBlock Text="Membership Tiers" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Five prices: Bronze, Silver, Gold, Platinum, Diamond"
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </GroupBox>

        <!-- ARC pricing fields -->
        <StackPanel x:Name="ArcPricingPanel">
          <GroupBox Header="Event Options" Margin="0,0,0,16">
            <StackPanel Margin="10">
              <CheckBox x:Name="ArcOnlyCheck"
                        Content="ARC Only (non-ARC buy-ins disabled)"
                        FontSize="14"
                        Margin="0,0,0,8"/>
              <TextBlock Text="When enabled, the buy-in screen only offers ARC member pricing."
                         FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Initial Buy-in Amounts" Margin="0,0,0,16">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="ARC Member Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="ArcBuyInBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Non-ARC Member Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="NonArcBuyInBox" Grid.Row="1" Grid.Column="1"/>
            </Grid>
          </GroupBox>

          <GroupBox Header="Rebuy Amounts" Margin="0,0,0,16">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="ARC Member Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="ArcRebuyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Non-ARC Member Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="NonArcRebuyBox" Grid.Row="1" Grid.Column="1"/>
            </Grid>
          </GroupBox>
        </StackPanel>

        <!-- Membership tier pricing fields -->
        <StackPanel x:Name="MembershipPricingPanel" Visibility="Collapsed">
          <GroupBox Header="Initial Buy-in Amounts" Margin="0,0,0,16">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Bronze Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="BronzeBuyInBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Silver Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="SilverBuyInBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="GoldBuyInBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Platinum Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="PlatinumBuyInBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Diamond Buy-in ($):" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="DiamondBuyInBox" Grid.Row="4" Grid.Column="1"/>
            </Grid>
          </GroupBox>

          <GroupBox Header="Rebuy Amounts" Margin="0,0,0,16">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Bronze Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="BronzeRebuyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Silver Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="SilverRebuyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Gold Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="GoldRebuyBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Platinum Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,8"/>
              <TextBox x:Name="PlatinumRebuyBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Diamond Rebuy ($):" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="DiamondRebuyBox" Grid.Row="4" Grid.Column="1"/>
            </Grid>
          </GroupBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Back" Width="100" Padding="12,8" Margin="0,0,8,0" Click="Close_Click"/>
      <Button Content="Save Pricing" Width="140" Padding="12,8" FontWeight="Bold" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
