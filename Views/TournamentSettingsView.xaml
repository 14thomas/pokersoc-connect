<UserControl x:Class="pokersoc_connect.Views.TournamentSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Tournament Settings" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
              Width="30" Height="30" Click="Close_Click" FontSize="16"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Pricing Structure" Margin="0,0,0,16">
          <StackPanel Margin="10">
            <TextBlock x:Name="PricingStructureSummary"
                       Text=""
                       FontSize="14"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>
            <Button Content="Configure Pricing Structure…"
                    Padding="16,14"
                    FontSize="15"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    Background="#E8F4FD"
                    Click="ConfigurePricing_Click"/>
            <TextBlock Text="Choose ARC vs Non-ARC, or membership-tier pricing, then set buy-in and rebuy amounts."
                       FontSize="11" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Rebuy Limit">
          <StackPanel Margin="10">
            <CheckBox x:Name="UnlimitedRebuysCheck"
                      Content="Unlimited rebuys"
                      FontSize="14"
                      Margin="0,0,0,8"
                      Checked="UnlimitedRebuysCheck_Changed"
                      Unchecked="UnlimitedRebuysCheck_Changed"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Max rebuys per player:" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="RebuyCapBox" Width="80" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Each player gets one initial buy-in plus up to this many rebuys."
                       FontSize="11" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Save Settings" Width="140" Padding="12,8" FontWeight="Bold" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
