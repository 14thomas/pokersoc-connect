<UserControl x:Class="pokersoc_connect.Views.BuyInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- STEP 0: TOURNAMENT TYPE SELECTION -->
    <Grid x:Name="TournamentTypeView" Grid.Row="0" Visibility="Collapsed">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tournament Buy-in" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,8"/>
        <TextBlock x:Name="TournamentTypeSubtitle"
                   Grid.Row="1"
                   Text="Select buy-in type"
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0,0,0,20"/>

        <!-- ARC vs Non-ARC selection -->
        <Grid x:Name="ArcTypeSelectionPanel" Grid.Row="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="ArcMemberTypeButton"
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  Padding="20,30"
                  Click="ArcMemberType_Click"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#E8F4FD">
            <StackPanel>
              <TextBlock Text="ARC MEMBER" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock x:Name="ArcMemberPriceText" Text="" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2E6DA4"/>
              <TextBlock x:Name="ArcMemberTypeLabel" Text="" FontSize="12" HorizontalAlignment="Center" Opacity="0.7" Margin="0,6,0,0"/>
            </StackPanel>
          </Button>

          <Button x:Name="NonArcMemberTypeButton"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="20,30"
                  Click="NonArcMemberType_Click"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#FFF8E8">
            <StackPanel>
              <TextBlock Text="NON-ARC MEMBER" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock x:Name="NonArcMemberPriceText" Text="" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#B8860B"/>
              <TextBlock x:Name="NonArcMemberTypeLabel" Text="" FontSize="12" HorizontalAlignment="Center" Opacity="0.7" Margin="0,6,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Membership tier selection -->
        <Grid x:Name="MembershipTypeSelectionPanel" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="BronzeTypeButton" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                  Tag="Bronze" Click="MembershipType_Click"
                  MinHeight="90" Margin="0,0,6,6" Padding="12,16"
                  BorderThickness="2" BorderBrush="Gray" Background="#CD7F32"
                  Foreground="White">
            <StackPanel>
              <TextBlock Text="BRONZE" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="BronzePriceText" Text="" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="BronzeTypeLabel" Text="" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="SilverTypeButton" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                  Tag="Silver" Click="MembershipType_Click"
                  MinHeight="90" Margin="6,0,0,6" Padding="12,16"
                  BorderThickness="2" BorderBrush="Gray" Background="#A8A8A8"
                  Foreground="White">
            <StackPanel>
              <TextBlock Text="SILVER" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SilverPriceText" Text="" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="SilverTypeLabel" Text="" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>

          <Button x:Name="GoldTypeButton" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  Tag="Gold" Click="MembershipType_Click"
                  MinHeight="90" Margin="0,6,4,0" Padding="12,16"
                  BorderThickness="2" BorderBrush="Gray" Background="#D4AF37"
                  Foreground="White">
            <StackPanel>
              <TextBlock Text="GOLD" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="GoldPriceText" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="GoldTypeLabel" Text="" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="PlatinumTypeButton" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                  Tag="Platinum" Click="MembershipType_Click"
                  MinHeight="90" Margin="4,6,4,0" Padding="12,16"
                  BorderThickness="2" BorderBrush="Gray" Background="#6E7F8A"
                  Foreground="White">
            <StackPanel>
              <TextBlock Text="PLATINUM" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PlatinumPriceText" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="PlatinumTypeLabel" Text="" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="DiamondTypeButton" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                  Tag="Diamond" Click="MembershipType_Click"
                  MinHeight="90" Margin="4,6,0,0" Padding="12,16"
                  BorderThickness="2" BorderBrush="Gray" Background="#4A90D9"
                  Foreground="White">
            <StackPanel>
              <TextBlock Text="DIAMOND" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DiamondPriceText" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="DiamondTypeLabel" Text="" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock x:Name="RebuyCapWarningText"
                   Grid.Row="2"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Visibility="Collapsed"
                   Margin="0,0,0,20"/>

        <Button Grid.Row="3"
                Content="Back to Main"
                HorizontalAlignment="Left"
                Padding="16,10"
                Click="Back_Click"/>
      </Grid>
    </Grid>

    <!-- STEP 1: CASH INPUT VIEW -->
    <Grid x:Name="CashInputView" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT SIDE: CASH INPUT TABLE -->
      <Grid Grid.Column="0" Margin="12,12,6,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cash input header -->
        <TextBlock Text="Cash Received" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <!-- Custom Cash input table -->
        <Grid Grid.Row="1" Background="White">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <!-- Header Row -->
          <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1,1,1,1" Background="#E0E0E0">
            <Grid Height="40">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Denomination" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
              <TextBlock Grid.Column="1" Text="Count" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
              <TextBlock Grid.Column="2" Text="Value" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
            </Grid>
          </Border>
          
          <!-- Data Rows Container - ItemsControl shares available vertical space -->
          <ItemsControl x:Name="CashInputRowsPanel" Grid.Row="1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>

        <!-- Player Info Display (Read-only) -->
        <Border Grid.Row="2" 
                BorderBrush="DarkGray" 
                BorderThickness="2" 
                Background="LightGray" 
                Padding="10" 
                Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Current Player" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
              <TextBlock Text="Player ID: " FontWeight="Bold" Width="80"/>
              <TextBlock x:Name="PlayerIdDisplay" Text="" FontSize="14"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Name: " FontWeight="Bold" Width="80"/>
              <TextBlock x:Name="PlayerNameDisplay" Text="" FontSize="14"/>
            </StackPanel>
            <Border x:Name="TournamentInfoPanel"
                    BorderBrush="#4A90D9"
                    BorderThickness="1"
                    Background="#E8F4FD"
                    Padding="8"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Tournament Buy-in" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Amount: " FontWeight="Bold" Width="100"/>
                  <TextBlock x:Name="TournamentBuyInDisplay" Text="" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="TournamentBuyInTypeDisplay" Text="" FontSize="12" Margin="0,4,0,0" Opacity="0.8"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Undo and Clear Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          
          <!-- Clear Button -->
          <Button x:Name="ClearCashButton" Grid.Column="0" Margin="0,0,5,0" Click="Clear_Click"
                  Padding="15,20" BorderThickness="1,0,1,1" BorderBrush="Gray" Background="Orange">
            <StackPanel>
              <TextBlock Text="🗑️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Clear" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="All cash" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>

              <!-- Undo Button -->
              <Button x:Name="UndoCashButton" Grid.Column="1" Margin="5,0,0,0" Click="Undo_Click"
                      Padding="15,20" BorderThickness="1,0,1,1" BorderBrush="Gray" Background="Yellow">
            <StackPanel>
              <TextBlock Text="↶" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Undo" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Last action" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>
            </Grid>

        <!-- Total Cash Panel -->
        <Border Grid.Row="4"
                Margin="0,0,0,0"
                Padding="15,20"
                BorderThickness="1,0,1,1"
                BorderBrush="Gray"
                Background="LightGreen">
          <StackPanel>
            <TextBlock Text="💰" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Total Cash" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TotalCashText" Text="$0.00" FontSize="14" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
              </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          
          <!-- Back Button -->
          <Button Grid.Column="0" Margin="0,0,5,0" Click="Back_Click"
                  Padding="15,20" BorderThickness="1,0,1,1" BorderBrush="Gray" Background="LightCoral">
            <StackPanel>
              <TextBlock Text="🏠" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Back" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Return to main" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>

          <!-- Next Button -->
          <Button x:Name="NextButton" Grid.Column="1" Margin="5,0,0,0" Click="NextToAmount_Click"
                  Padding="15,20" BorderThickness="1,0,1,1" BorderBrush="Gray" Background="LightBlue">
            <StackPanel>
              <TextBlock x:Name="NextButtonIcon" Text="➡️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock x:Name="NextButtonTitle" Text="Next" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="NextButtonSubtitle" Text="Set buy-in amount" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <!-- RIGHT SIDE: DENOMINATION BUTTONS AND CONTROLS -->
      <Grid Grid.Column="1" Margin="6,12,12,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Denomination Buttons Grid -->
        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

          <!-- Row 1 -->
          <!-- 5c Button -->
          <Button x:Name="Cash5c" Grid.Row="0" Grid.Column="0"
                  Margin="0,0,5,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="5"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#C0C0C0"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash5cCount" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <Image Grid.Column="3" x:Name="Cash5cImage" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <TextBlock x:Name="Cash5cText" Text="5c" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- 10c Button -->
          <Button x:Name="Cash10c" Grid.Row="0" Grid.Column="1"
                  Margin="5,0,0,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="10"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#C0C0C0"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Image Grid.Column="1" x:Name="Cash10cImage" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <Border Grid.Column="3" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash10cCount" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash10cText" Text="10c" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Row 2 -->
          <!-- 20c Button -->
          <Button x:Name="Cash20c" Grid.Row="1" Grid.Column="0"
                  Margin="0,5,5,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="20"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#C0C0C0"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash20cCount" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <Image Grid.Column="3" x:Name="Cash20cImage" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <TextBlock x:Name="Cash20cText" Text="20c" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- 50c Button -->
          <Button x:Name="Cash50c" Grid.Row="1" Grid.Column="1"
                  Margin="5,5,0,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="50"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#C0C0C0"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Image Grid.Column="1" x:Name="Cash50cImage" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <Border Grid.Column="3" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash50cCount" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash50cText" Text="50c" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Row 3 -->
          <!-- $1 Button -->
          <Button x:Name="Cash1" Grid.Row="2" Grid.Column="0"
                  Margin="0,5,5,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="100"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#B8860B"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash1Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <Image Grid.Column="3" x:Name="Cash1Image" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <TextBlock x:Name="Cash1Text" Text="$1" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- $2 Button -->
          <Button x:Name="Cash2" Grid.Row="2" Grid.Column="1"
                  Margin="5,5,0,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="200"
                  BorderThickness="2"
                  BorderBrush="Gray"
                  Background="#B8860B"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Image Grid.Column="1" x:Name="Cash2Image" Stretch="Uniform" VerticalAlignment="Stretch"/>
              <Border Grid.Column="3" VerticalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8">
                <TextBlock x:Name="Cash2Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash2Text" Text="$2" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Row 4 -->
          <!-- $5 Button -->
          <Button x:Name="Cash5" Grid.Row="3" Grid.Column="0"
                  Margin="0,5,5,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="500"
                  BorderThickness="2"
                  BorderBrush="Gray">
            <Grid>
              <Image x:Name="Cash5Image" Stretch="Fill"/>
              <Rectangle Fill="#40000000"/>
              <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8" Margin="4">
                <TextBlock x:Name="Cash5Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash5Text" Text="$5" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- $10 Button -->
          <Button x:Name="Cash10" Grid.Row="3" Grid.Column="1"
                  Margin="5,5,0,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="1000"
                  BorderThickness="2"
                  BorderBrush="Gray">
            <Grid>
              <Image x:Name="Cash10Image" Stretch="Fill"/>
              <Rectangle Fill="#40000000"/>
              <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8" Margin="4">
                <TextBlock x:Name="Cash10Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash10Text" Text="$10" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Row 5 -->
          <!-- $20 Button -->
          <Button x:Name="Cash20" Grid.Row="4" Grid.Column="0"
                  Margin="0,5,5,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="2000"
                  BorderThickness="2"
                  BorderBrush="Gray">
            <Grid>
              <Image x:Name="Cash20Image" Stretch="Fill"/>
              <Rectangle Fill="#40000000"/>
              <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8" Margin="4">
                <TextBlock x:Name="Cash20Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash20Text" Text="$20" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- $50 Button -->
          <Button x:Name="Cash50" Grid.Row="4" Grid.Column="1"
                  Margin="5,5,0,5"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="5000"
                  BorderThickness="2"
                  BorderBrush="Gray">
            <Grid>
              <Image x:Name="Cash50Image" Stretch="Fill"/>
              <Rectangle Fill="#40000000"/>
              <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8" Margin="4">
                <TextBlock x:Name="Cash50Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash50Text" Text="$50" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Row 6 -->
          <!-- $100 Button -->
          <Button x:Name="Cash100" Grid.Row="5" Grid.Column="0"
                  Margin="0,5,5,0"
                  Padding="0"
                  Click="CashDenom_Click"
                  Tag="10000"
                  BorderThickness="2"
                  BorderBrush="Gray">
            <Grid>
              <Image x:Name="Cash100Image" Stretch="Fill"/>
              <Rectangle Fill="#40000000"/>
              <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                       Background="#E0FFFFFF" BorderBrush="#404040" BorderThickness="3" CornerRadius="8"
                       Padding="12,8" Margin="4">
                <TextBlock x:Name="Cash100Count" Text="×0" FontSize="32" FontWeight="Bold" 
                           Foreground="#202020" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Cash100Text" Text="$100" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Multiplier Controls -->
          <Grid Grid.Row="5" Grid.Column="1" Margin="5,5,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1x Button -->
            <Button x:Name="Cash1xButton" Grid.Column="0"
                    Margin="0,0,2,0"
                    Padding="5,10"
                    BorderThickness="2"
                    BorderBrush="Gray"
                    Background="LightGreen"
                    Click="CashMultiplier1x_Click">
              <StackPanel>
                <TextBlock Text="×1" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
              </StackPanel>
            </Button>

            <!-- 5x Button -->
            <Button x:Name="Cash5xButton" Grid.Column="1"
                    Margin="2,0,2,0"
                    Padding="5,10"
                    BorderThickness="2"
                    BorderBrush="Gray"
                    Background="LightBlue"
                    Click="CashMultiplier5x_Click">
              <StackPanel>
                <TextBlock Text="×5" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
              </StackPanel>
            </Button>

            <!-- 20x Button -->
            <Button x:Name="Cash20xButton" Grid.Column="2"
                    Margin="2,0,0,0"
                    Padding="5,10"
                    BorderThickness="2"
                    BorderBrush="Gray"
                    Background="LightBlue"
                    Click="CashMultiplier20x_Click">
              <StackPanel>
                <TextBlock Text="×20" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- STEP 2: BUY-IN AMOUNT VIEW -->
    <Grid x:Name="AmountInputView" Grid.Row="0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT SIDE: CHANGE BREAKDOWN -->
      <Grid Grid.Column="0" Margin="12,12,6,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Change breakdown header -->
        <TextBlock Text="Change to Give" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <!-- Change breakdown table (matching Cash Received style) -->
        <Grid Grid.Row="1" Background="White">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <!-- Header Row -->
          <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1,1,1,1" Background="#E0E0E0">
            <Grid Height="40">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Denomination" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
              <TextBlock Grid.Column="1" Text="Count" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
              <TextBlock Grid.Column="2" Text="Value" FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
            </Grid>
          </Border>
          
          <!-- Data Rows Container - ItemsControl shares available vertical space -->
          <ItemsControl x:Name="ChangeRowsPanel" Grid.Row="1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>

        <!-- Player Info Display (Read-only) -->
        <Border Grid.Row="2" 
                BorderBrush="DarkGray" 
                BorderThickness="2" 
                Background="LightGray" 
                Padding="10" 
                Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="Current Player" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
              <TextBlock Text="Player ID: " FontWeight="Bold" Width="80"/>
              <TextBlock x:Name="PlayerIdDisplay2" Text="" FontSize="14"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Name: " FontWeight="Bold" Width="80"/>
              <TextBlock x:Name="PlayerNameDisplay2" Text="" FontSize="14"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Clear and Reset Buttons -->
        <Grid x:Name="AmountEditButtons" Grid.Row="3" Margin="0,10,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          
          <!-- Clear Button (set to $0) -->
          <Button Grid.Column="0" Margin="0,0,5,0" Click="ClearAmount_Click"
                  Padding="15,20" BorderThickness="1" BorderBrush="Gray" Background="Orange">
            <StackPanel>
              <TextBlock Text="🗑️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Clear" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Set to $0" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>

          <!-- Reset Button (set to full amount) -->
          <Button Grid.Column="1" Margin="5,0,0,0" Click="ResetAmount_Click"
                  Padding="15,20" BorderThickness="1" BorderBrush="Gray" Background="Yellow">
            <StackPanel>
              <TextBlock Text="↺" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Reset" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Full amount" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Change Display -->
        <Border Grid.Row="4"
                Margin="0,0,0,0"
                Padding="15,20"
                BorderThickness="1"
                BorderBrush="Gray"
                Background="LightGreen">
          <StackPanel>
            <TextBlock Text="🔄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Change Due" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ChangeText" Text="$0.00" FontSize="14" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          
          <!-- Back Button -->
          <Button Grid.Column="0" Margin="0,0,5,0" Click="BackToCash_Click"
                  Padding="15,20" BorderThickness="1" BorderBrush="Gray" Background="LightCoral">
            <StackPanel>
              <TextBlock Text="⬅️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Back" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Edit cash" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>

          <!-- Confirm Button -->
          <Button Grid.Column="1" Margin="5,0,0,0" Click="ConfirmBuyIn_Click"
                  Padding="15,20" BorderThickness="1" BorderBrush="Gray" Background="LightGreen">
            <StackPanel>
              <TextBlock Text="✅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock Text="Confirm" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="Process buy-in" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <!-- RIGHT SIDE: AMOUNT INPUT AND NUMBERPAD -->
      <Grid Grid.Column="1" Margin="6,12,12,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Amount input header -->
        <TextBlock Text="Buy-in Amount" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <!-- Amount Display -->
        <Border Grid.Row="1" Background="LightYellow" BorderBrush="Gray" BorderThickness="2" 
                CornerRadius="5" Padding="20" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Cash Received:" FontSize="14" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="CashReceivedText" Text="$0.00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Buy-in Amount:" FontSize="14" HorizontalAlignment="Center" Opacity="0.7" Margin="0,10,0,0"/>
            <TextBlock x:Name="BuyInAmountText" Text="$0.00" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>
      </StackPanel>
        </Border>

        <!-- Numberpad -->
        <Grid x:Name="NumpadPanel" Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Row 1 -->
          <Button Grid.Row="0" Grid.Column="0" Content="1" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="1"/>
          <Button Grid.Row="0" Grid.Column="1" Content="2" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="2"/>
          <Button Grid.Row="0" Grid.Column="2" Content="3" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="3"/>

          <!-- Row 2 -->
          <Button Grid.Row="1" Grid.Column="0" Content="4" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="4"/>
          <Button Grid.Row="1" Grid.Column="1" Content="5" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="5"/>
          <Button Grid.Row="1" Grid.Column="2" Content="6" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="6"/>

          <!-- Row 3 -->
          <Button Grid.Row="2" Grid.Column="0" Content="7" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="7"/>
          <Button Grid.Row="2" Grid.Column="1" Content="8" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="8"/>
          <Button Grid.Row="2" Grid.Column="2" Content="9" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="9"/>

          <!-- Row 4 -->
          <Button Grid.Row="3" Grid.Column="0" Content="." FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="."/>
          <Button Grid.Row="3" Grid.Column="1" Content="0" FontSize="24" FontWeight="Bold" Margin="2" Click="Number_Click" Tag="0"/>
          <Button Grid.Row="3" Grid.Column="2" Content="⌫" FontSize="24" FontWeight="Bold" Margin="2" Click="Backspace_Click"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- TIMEOUT CONFIRMATION OVERLAY -->
    <Grid x:Name="TimeoutConfirmationPanel" Grid.Row="0" Visibility="Collapsed" Background="#CC000000">
      <Border Background="White" CornerRadius="10" Padding="30" 
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="400" MaxWidth="600">
        <StackPanel>
          <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
          <TextBlock Text="Buy-in Limit Warning" FontSize="24" FontWeight="Bold" 
                     HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="DarkOrange"/>
          <TextBlock x:Name="TimeoutWarningText" TextWrapping="Wrap" FontSize="16" 
                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Text="This player's total buy-ins for this session will exceed $500." 
                     TextWrapping="Wrap" FontSize="14" HorizontalAlignment="Center" 
                     TextAlignment="Center" Margin="0,0,0,20" Foreground="Gray"/>
          
          <Border Background="LightYellow" BorderBrush="Orange" BorderThickness="2" 
                  CornerRadius="5" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="Has this player had a 15-minute timeout?" 
                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
          </Border>
          
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- No Button (Reject) -->
            <Button Grid.Column="0" Margin="0,0,10,0" Click="TimeoutNo_Click"
                    Padding="20,15" Background="LightCoral">
              <StackPanel>
                <TextBlock Text="❌" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="No" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Reject buy-in" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"/>
              </StackPanel>
            </Button>
            
            <!-- Yes Button (Proceed) -->
            <Button Grid.Column="1" Margin="10,0,0,0" Click="TimeoutYes_Click"
                    Padding="20,15" Background="LightGreen">
              <StackPanel>
                <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="Yes" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Proceed with buy-in" FontSize="11" HorizontalAlignment="Center" Opacity="0.7"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
