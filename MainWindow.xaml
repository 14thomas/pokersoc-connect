<Window x:Class="pokersoc_connect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pokersoc-connect"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- MAIN CONTENT AREA -->
    <Grid x:Name="MainContent" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT SIDE: PLAYER ID + ACTIVITY LOG -->
      <Grid Grid.Column="0" Margin="12,12,6,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Current Player Section -->
        <Border Grid.Row="0" 
                BorderBrush="Gray" 
                BorderThickness="2" 
                Background="LightBlue" 
                Padding="10" 
                Margin="0,0,0,15">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Current Player (Scan ID or Press Enter)" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Grid.Row="0" 
                       Margin="0,0,0,5"/>
            
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              
              <TextBox x:Name="CurrentPlayerIdBox"
                       Grid.Column="0"
                       FontSize="16"
                       VerticalContentAlignment="Center"
                       Padding="5"
                       KeyDown="CurrentPlayerIdBox_KeyDown"
                       TextChanged="CurrentPlayerIdBox_TextChanged"/>
              
              <Button x:Name="EditPlayerBtn"
                      Grid.Column="1"
                      Content="Edit"
                      FontSize="14"
                      FontWeight="Bold"
                      MinWidth="56"
                      Margin="5,0,0,0"
                      Padding="10,5"
                      Background="#FFE0B2"
                      IsEnabled="False"
                      Click="EditPlayer_Click"/>
              
              <Button x:Name="ClearPlayerBtn"
                      Grid.Column="2"
                      Content="✕"
                      FontSize="16"
                      FontWeight="Bold"
                      Width="40"
                      Margin="5,0,0,0"
                      Background="LightCoral"
                      Click="ClearPlayer_Click"/>
            </Grid>
            
            <!-- New Player Verification Panel (Hidden by default) -->
            <Border x:Name="NewPlayerPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    BorderBrush="Orange"
                    BorderThickness="2"
                    Background="LightYellow"
                    Padding="10"
                    Margin="0,10,0,0">
              <Grid>
                <!-- Step 1: Age verification -->
                <Grid x:Name="NewPlayerAgeStep">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  
                  <TextBlock Grid.Row="0" 
                            Text="⚠️ NEW PLAYER DETECTED" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Foreground="DarkOrange"
                            Margin="0,0,0,5"/>
                  
                  <TextBlock x:Name="NewPlayerIdText"
                            Grid.Row="1"
                            Text="Player ID: "
                            FontSize="12"
                            Margin="0,0,0,3"/>
                  
                  <TextBlock x:Name="Age18CutoffText"
                            Grid.Row="1"
                            Text=""
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="DarkBlue"
                            Margin="0,18,0,5"/>
                  
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="✓ 18+"
                            Click="VerifyNewPlayer_Click"
                            Background="LightGreen"
                            Padding="8,5"
                            Margin="0,0,3,0"
                            FontWeight="Bold"/>
                    <Button Grid.Column="1" Content="👶 Underage"
                            Click="VerifyNewPlayerUnderage_Click"
                            Background="#FFFFCC"
                            Padding="8,5"
                            Margin="3,0,3,0"
                            FontWeight="Bold"/>
                    <Button Grid.Column="2" Content="✕ Cancel"
                            Click="CancelNewPlayer_Click"
                            Background="LightCoral"
                            Padding="8,5"
                            Margin="3,0,0,0"
                            FontWeight="Bold"/>
                  </Grid>
                </Grid>

                <!-- Step 2: Membership type (shown after 18+) -->
                <Grid x:Name="NewPlayerMembershipStep" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0"
                            Text="Membership Type"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="DarkOrange"
                            Margin="0,0,0,5"/>

                  <TextBlock x:Name="MembershipPlayerIdText"
                            Grid.Row="1"
                            Text="Player ID: "
                            FontSize="12"
                            Margin="0,0,0,10"/>

                  <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Content="Bronze" Tag="Bronze"
                            Click="SelectMembershipType_Click"
                            MinHeight="56" FontSize="16" Margin="0,0,4,4" FontWeight="Bold"
                            Background="#CD7F32" Foreground="White"/>
                    <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                            Content="Silver" Tag="Silver"
                            Click="SelectMembershipType_Click"
                            MinHeight="56" FontSize="16" Margin="4,0,0,4" FontWeight="Bold"
                            Background="#A8A8A8" Foreground="White"/>

                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Gold" Tag="Gold"
                            Click="SelectMembershipType_Click"
                            MinHeight="56" FontSize="16" Margin="0,4,4,0" FontWeight="Bold"
                            Background="#D4AF37" Foreground="White"/>
                    <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                            Content="Platinum" Tag="Platinum"
                            Click="SelectMembershipType_Click"
                            MinHeight="56" FontSize="16" Margin="4,4,4,0" FontWeight="Bold"
                            Background="#6E7F8A" Foreground="White"/>
                    <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                            Content="Diamond" Tag="Diamond"
                            Click="SelectMembershipType_Click"
                            MinHeight="56" FontSize="16" Margin="4,4,0,0" FontWeight="Bold"
                            Background="#4A90D9" Foreground="White"/>
                  </Grid>

                  <Button Grid.Row="3" Content="✕ Cancel"
                          Click="CancelNewPlayer_Click"
                          Background="LightCoral"
                          Padding="10,10"
                          FontSize="14"
                          HorizontalAlignment="Stretch"
                          FontWeight="Bold"/>
                </Grid>
              </Grid>
            </Border>
            
            <!-- Edit Membership Panel (for correcting current player) -->
            <Border x:Name="EditMembershipPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    BorderBrush="#E65100"
                    BorderThickness="2"
                    Background="#FFF3E0"
                    Padding="10"
                    Margin="0,10,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                          Text="Edit Membership Type"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="#E65100"
                          Margin="0,0,0,5"/>

                <TextBlock x:Name="EditMembershipPlayerText"
                          Grid.Row="1"
                          Text=""
                          FontSize="12"
                          Margin="0,0,0,10"/>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Bronze" Tag="Bronze"
                          Click="EditMembershipType_Click"
                          MinHeight="56" FontSize="16" Margin="0,0,4,4" FontWeight="Bold"
                          Background="#CD7F32" Foreground="White"/>
                  <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                          Content="Silver" Tag="Silver"
                          Click="EditMembershipType_Click"
                          MinHeight="56" FontSize="16" Margin="4,0,0,4" FontWeight="Bold"
                          Background="#A8A8A8" Foreground="White"/>

                  <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Gold" Tag="Gold"
                          Click="EditMembershipType_Click"
                          MinHeight="56" FontSize="16" Margin="0,4,4,0" FontWeight="Bold"
                          Background="#D4AF37" Foreground="White"/>
                  <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                          Content="Platinum" Tag="Platinum"
                          Click="EditMembershipType_Click"
                          MinHeight="56" FontSize="16" Margin="4,4,4,0" FontWeight="Bold"
                          Background="#6E7F8A" Foreground="White"/>
                  <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                          Content="Diamond" Tag="Diamond"
                          Click="EditMembershipType_Click"
                          MinHeight="56" FontSize="16" Margin="4,4,0,0" FontWeight="Bold"
                          Background="#4A90D9" Foreground="White"/>
                </Grid>

                <Button Grid.Row="3" Content="✕ Cancel"
                        Click="CancelEditMembership_Click"
                        Background="LightCoral"
                        Padding="10,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        FontWeight="Bold"/>
              </Grid>
            </Border>
            
            <!-- Underage Player Indicator (Hidden by default) -->
            <Border x:Name="UnderagePlayerPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    BorderBrush="Red"
                    BorderThickness="2"
                    Background="#FFDDDD"
                    Padding="10"
                    Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="🚫 UNDERAGE PLAYER" 
                          FontSize="14" 
                          FontWeight="Bold" 
                          Foreground="Red"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,3"/>
                <TextBlock Text="Cannot buy-in or cash-out" 
                          FontSize="11" 
                          Foreground="DarkRed"
                          HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            
            <!-- Player Info Panel (Hidden by default, shown when existing player scanned) -->
            <Border x:Name="PlayerInfoPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    BorderBrush="#4A90D9"
                    BorderThickness="2"
                    Background="#E8F4FD"
                    Padding="8"
                    Margin="0,10,0,0">
              <StackPanel x:Name="PlayerInfoStack">
                <!-- Dynamic content added via code-behind -->
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Activity header -->
        <TextBlock Text="Activity Log" FontSize="18" FontWeight="Bold" Grid.Row="1" Margin="0,0,0,10"/>

        <!-- Activity table -->
        <DataGrid x:Name="TxGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time" Binding="{Binding time}" Width="120"/>
            <DataGridTextColumn Header="Type" Binding="{Binding type}" Width="100"/>
            <DataGridTextColumn Header="Player" Binding="{Binding player_id}" Width="120"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding cash_amt, StringFormat=C}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- RIGHT SIDE: 8 BUTTON GRID (2 COLUMNS x 4 ROWS) -->
      <Grid Grid.Column="1" Margin="6,12,12,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Row 1 -->
        <!-- Buy-in Button -->
        <Button x:Name="BuyInButton"
                Grid.Row="0" Grid.Column="0"
                Margin="0,0,5,5"
                Padding="15,20"
                Click="BuyIn_Click"
                BorderThickness="2"
                BorderBrush="Gray"
                IsEnabled="False">
          <StackPanel>
            <TextBlock Text="💵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Buy-in" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Record player buy-in" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Cash-out Button -->
        <Button x:Name="CashOutButton"
                Grid.Row="0" Grid.Column="1"
                Margin="5,0,0,5"
                Padding="15,20"
                Click="CashOut_Click"
                BorderThickness="2"
                BorderBrush="Gray"
                IsEnabled="False">
          <StackPanel>
            <TextBlock x:Name="CashOutIcon" Text="💸" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="CashOutTitle" Text="Cash-out" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CashOutSubtitle" Text="Record player cash-out" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Row 2 -->
        <!-- Cashbox Button -->
        <Button Grid.Row="1" Grid.Column="0"
                Margin="0,5,5,5"
                Padding="15,20"
                Click="Cashbox_Click"
                BorderThickness="2"
                BorderBrush="Gray">
          <StackPanel>
            <TextBlock Text="💰" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Cashbox" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Manage float and cash" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Food Button -->
        <Button Grid.Row="1" Grid.Column="1"
                Margin="5,5,0,5"
                Padding="15,20"
                Click="Food_Click"
                BorderThickness="2"
                BorderBrush="Gray">
          <StackPanel>
            <TextBlock Text="🍕" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Food" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Sell food and drinks" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Row 3 -->
        <!-- Players Button -->
        <Button Grid.Row="2" Grid.Column="0"
                Margin="0,5,5,5"
                Padding="15,20"
                Click="Players_Click"
                BorderThickness="2"
                BorderBrush="Gray">
          <StackPanel>
            <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Players" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Manage player database" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Tournament Info / Button 6 -->
        <Button x:Name="TournamentInfoButton"
                Grid.Row="2" Grid.Column="1"
                Margin="5,5,0,5"
                Padding="15,20"
                Click="TournamentInfo_Click"
                BorderThickness="2"
                BorderBrush="LightGray"
                IsEnabled="False">
          <StackPanel>
            <TextBlock x:Name="TournamentInfoIcon" Text="📊" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.3"/>
            <TextBlock x:Name="TournamentInfoTitle" Text="Button 6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock x:Name="TournamentInfoSubtitle" Text="Coming soon" FontSize="10" HorizontalAlignment="Center" Opacity="0.3"/>
          </StackPanel>
        </Button>

        <!-- Row 4 -->
        <!-- Lost Chips / Tournament Settings Button -->
        <Button x:Name="LostChipsButton"
                Grid.Row="3" Grid.Column="0"
                Margin="0,5,5,0"
                Padding="15,20"
                Click="LostChips_Click"
                BorderThickness="2"
                BorderBrush="Gray">
          <StackPanel>
            <TextBlock x:Name="LostChipsIcon" Text="💸" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="LostChipsTitle" Text="Lost Chips" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LostChipsSubtitle" Text="Record lost chips as tips" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>

        <!-- Settings Button (Bottom Right) -->
        <Button Grid.Row="3" Grid.Column="1"
                Margin="5,5,0,0"
                Padding="15,20"
                Click="Settings_Click"
                BorderThickness="2"
                BorderBrush="Gray">
          <StackPanel>
            <TextBlock Text="⚙" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Configure system" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>


    <!-- OVERLAY HOSTS FOR MODAL CONTENT - These cover the entire window -->
    <ContentControl x:Name="ScreenHost" Visibility="Collapsed" Grid.Row="0"/>
    <ContentControl x:Name="SettingsHost" Visibility="Collapsed" Grid.Row="0"/>
    <ContentControl x:Name="FoodHost" Visibility="Collapsed" Grid.Row="0"/>

    <!-- Close Session Confirmation Panel -->
    <Border x:Name="CloseConfirmationPanel" 
            Grid.Row="0"
            Background="#DD000000" 
            Visibility="Collapsed">
      <Border Background="White" 
              Padding="30" 
              CornerRadius="10"
              MaxWidth="500"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Close Session?" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
          <TextBlock Text="Are you sure you want to close the current session? Make sure you've saved any important data." 
                     FontSize="14" 
                     TextWrapping="Wrap" 
                     Margin="0,0,0,20"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Click="CancelCloseSession_Click" 
                    Padding="20,10" 
                    Margin="0,0,10,0"
                    FontSize="14"/>
            <Button Content="Close Session" 
                    Click="ConfirmCloseSession_Click" 
                    Padding="20,10" 
                    FontSize="14"
                    FontWeight="Bold"
                    Background="LightCoral"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
